# ========================================================================
# SMTP Email Configuration for Student Management System
# ========================================================================
# To enable email sending of academic reports, copy this file as 'smtp.properties'
# in the application root directory and fill in your SMTP credentials.
#
# IMPORTANT: Never commit 'smtp.properties' with actual credentials to git.
# It is listed in .gitignore for security.

# Gmail SMTP Settings:
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true

# Sender account details:
# For Gmail, use your full Gmail address and a 16-character Google App Password.
# How to get a Gmail App Password:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to 'App passwords': https://myaccount.google.com/apppasswords
# 3. Create a new app password (e.g. named "Student Management System")
# 4. Copy the generated 16-character code into mail.smtp.password below.
mail.smtp.user=your_email@gmail.com
mail.smtp.password=your_16_digit_app_password
mail.smtp.from=your_email@gmail.com

# Alternatively, you can configure these via Environment Variables:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password

